@echo off
rem Copy this file to secrets.cmd and fill in your real values.
rem secrets.cmd is gitignored, so it never gets committed.
rem
rem Recommended: generate this file from the secrets-link panel instead of editing by hand
rem (the panel writes the same shape, but with runtime-decrypted encrypted token files).

set "GITHUB_USER=hpsks416"
set "GITEE_USERNAME=hpsks416"

rem --- tokens (pick either: plaintext for a local sandbox, or let secrets-link generate
rem     the `for /f` lines that decrypt an encrypted .zip at runtime) ---
rem set "GITHUB_TOKEN=PASTE_YOUR_GITHUB_TOKEN_HERE"
rem set "GITEE_TOKEN=PASTE_YOUR_GITEE_TOKEN_HERE"
rem set "ATOMGIT_TOKEN=PASTE_YOUR_ATOMGIT_TOKEN_HERE"

rem --- optional ---
rem set "ATOMGIT_USER=your-atomgit-user"
rem set "ATOMGIT_HOST=atomgit.com"
rem set "GIT_HTTP_PROXY=http://127.0.0.1:7897"
